# API base path. Leave unset to use /api/v1 on the same origin (Vite proxies it to the Go server in dev).
# VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api (read by vite.config.ts, not exposed to the browser).
# API_PROXY_TARGET=http://localhost:8080

# BR-01 limits for early form validation. Keep equal to the API's .env; the server decides.
# VITE_OPERATING_HOURS_START=07:00
# VITE_OPERATING_HOURS_END=21:00
# VITE_BOOKING_MIN_DURATION_MINUTES=30
# VITE_BOOKING_MAX_DURATION_HOURS=8
# VITE_BOOKING_MAX_FUTURE_DAYS=30
