# Server Configuration
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Database Configuration (PostgreSQL 15+)
DB_HOST=localhost
DB_PORT=5432
DB_USER=classlab
DB_PASSWORD=classlab_secret
DB_NAME=classlab
DB_SSLMODE=disable
DATABASE_URL=postgres://classlab:classlab_secret@localhost:5432/classlab?sslmode=disable

# Authentication & Security
JWT_SECRET=super_secret_jwt_development_key_change_in_production_min32chars
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECURE=false

# CORS (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Business Rules Configuration (BR-01)
OPERATING_HOURS_START=07:00
OPERATING_HOURS_END=21:00
BOOKING_MIN_DURATION_MINUTES=30
BOOKING_MAX_DURATION_HOURS=8
BOOKING_MAX_FUTURE_DAYS=30

# File Upload Configuration
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# Password Hashing (argon2id; OWASP minimum is 19 MiB / 2 iterations / 1 lane)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Notification stream: comment line sent this often so proxies keep the connection open
SSE_HEARTBEAT=25s

# Booking quota (a pending booking holds its slot, so one student may only hold so many)
BOOKING_MAX_ACTIVE_PER_USER=5

# A statement waiting longer than this for a row lock fails with 503 instead of queueing
DB_LOCK_TIMEOUT=5s

# ---------------------------------------------------------------------------------------------
# Business rules BR-11 to BR-28 (docs/brief.md section 4.3). Values below are the defaults; a
# malformed or out-of-range value stops the server at start. Units are in the variable name.
# BOOKING_* above, BOOKING_MAX_ACTIVE_PER_USER and UPLOAD_MAX_BYTES stay until Phase 3 replaces them
# with per-room-type policies (BR-20), MAX_ACTIVE_BOOKINGS and MAX_UPLOAD_MB.
# ---------------------------------------------------------------------------------------------

# Pending bookings (BR-22) and edits (BR-26)
PENDING_TTL_HOURS=24
EDIT_CUTOFF_MIN=60
MAX_OCCURRENCES=14

# CSV imports (BR-23, BR-24)
IMPORT_MAX_MB=2
IMPORT_MAX_ROWS=5000
IMPORT_MAX_WEEKS=30

# Passwords (BR-24)
TEMP_PASSWORD_LENGTH=10
MIN_PASSWORD_LENGTH=10

# In-app reminders (BR-28)
REMINDER_CHECKIN_LAST_MIN=5
REMINDER_CHECKOUT_MIN=10

# Approval and quota (BR-15, BR-17): auto-approval needs fewer active points than AUTO_APPROVE_MAX_POINTS
AUTO_APPROVE_MAX_POINTS=1
MAX_ACTIVE_BOOKINGS=2
MAX_ACTIVE_BOOKINGS_ORG=5

# Letters and uploads (BR-16, BR-19)
MAX_LETTER_MB=5
LETTER_RETENTION_DAYS=365
ORPHAN_ATTACHMENT_HOURS=24
PHOTO_RETENTION_DAYS=60
MAX_UPLOAD_MB=5

# Check-in and check-out windows (BR-11, BR-13)
CHECKIN_EARLY_MIN=15
CHECKIN_LATE_MIN=15
CHECKOUT_GRACE_MIN=15

# Violations and blocking (BR-14)
LATE_CANCEL_HOURS=2
VIOLATION_WINDOW_DAYS=30
BLOCK_THRESHOLD_POINTS=6
BLOCK_DAYS=14
POINTS_NO_SHOW=2
POINTS_NO_CHECKOUT=1
POINTS_LATE_CANCEL=1
