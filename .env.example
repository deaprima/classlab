# Server Configuration
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Database Configuration (PostgreSQL 15+)
DB_HOST=localhost
DB_PORT=5432
DB_USER=classlab
DB_PASSWORD=classlab_secret
DB_NAME=classlab
DB_SSLMODE=disable
DATABASE_URL=postgres://classlab:classlab_secret@localhost:5432/classlab?sslmode=disable

# Authentication & Security
JWT_SECRET=super_secret_jwt_development_key_change_in_production_min32chars
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECURE=false

# CORS (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Business Rules Configuration (BR-01)
OPERATING_HOURS_START=07:00
OPERATING_HOURS_END=21:00
BOOKING_MIN_DURATION_MINUTES=30
BOOKING_MAX_DURATION_HOURS=8
BOOKING_MAX_FUTURE_DAYS=30

# File Upload Configuration
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# Password Hashing (argon2id; OWASP minimum is 19 MiB / 2 iterations / 1 lane)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Notification stream: comment line sent this often so proxies keep the connection open
SSE_HEARTBEAT=25s

# Booking quota (a pending booking holds its slot, so one student may only hold so many)
BOOKING_MAX_ACTIVE_PER_USER=5

# A statement waiting longer than this for a row lock fails with 503 instead of queueing
DB_LOCK_TIMEOUT=5s
