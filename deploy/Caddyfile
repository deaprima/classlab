# One address serves the app and the API, so the refresh cookie (SameSite=Strict, path /api/v1/auth)
# works without CORS, as in dev. Caddy gets and renews the HTTPS certificate by itself for a real
# domain; `localhost` uses Caddy's own local CA, which is enough to try the stack on one machine.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Everything is served from this origin. 'unsafe-inline' for styles only (React style
		# attributes and the print frame of the room QR); data:/blob: for the QR and camera photos.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# The camera is needed on this origin for check-in and check-out photos; nothing else is.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /api/* {
		# A letter or photo is at most 5 MB (MAX_UPLOAD_MB); the rest is the form around it.
		request_body {
			max_size 8MB
		}
		# flush_interval -1 passes the notification stream (SSE) through as it is written.
		reverse_proxy api:8080 {
			# Overwrites anything the caller sent; the API believes this header only from this proxy
			# (TRUSTED_PROXIES), so the login limiter and audit log see the real address.
			header_up X-Real-IP {client_ip}
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Built files carry a hash in their name, so they can be kept for good; the page that names
		# them must always be fetched again.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/* /fonts/* /images/*
		header @page Cache-Control "no-cache"
		# Any other path is a route of the single-page app.
		try_files {path} /index.html
		file_server
	}
}
