# Copy to .env (same folder) and fill in. Never commit .env.

# The public domain, without https:// . Its DNS must point at this server and ports 80 and 443 must
# be open, so Caddy can get the HTTPS certificate. Use `localhost` to try the stack on one machine.
SITE_ADDRESS=classlab.example.ac.id

# Generate both with:  openssl rand -hex 32
# Hex only: the database password sits inside a connection URL, so symbols would have to be escaped.
POSTGRES_PASSWORD=
JWT_SECRET=

# Optional
# LOG_LEVEL=info
